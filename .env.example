# ============================================================
#  اسپاتی‌دانلودر — نمونه تنظیمات
#  این فایل رو کپی کن به .env و مقادیر رو پر کن
# ============================================================

# توکن ربات — از @BotFather بگیر
BOT_TOKEN=123456789:AAE...

# ------------------------------------------------------------
# کلیدهای Spotify Web API (رایگان) — از developer.spotify.com
# بدون این دو خط هم دانلود «تک‌آهنگ» کار می‌کند،
# ولی برای آلبوم و پلی‌لیست خیلی توصیه می‌شه.
# ------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# کیفیت پیش‌فرض: 128 | 192 | 320
DEFAULT_QUALITY=192

# فرمت خروجی: mp3 | m4a
DEFAULT_FORMAT=mp3

# سقف آهنگ در هر سفارش (آلبوم / پلی‌لیست)
MAX_TRACKS_PER_JOB=20

# فاصلهٔ اجباری بین دو دانلود در هر چت (ثانیه) — 0 یعنی بدون محدودیت
RATE_LIMIT_SECONDS=15

# اعتبار دکمه‌های انتخاب کیفیت (ثانیه)
JOB_TTL_SECONDS=900

# پوشهٔ دانلود‌های موقت و سطح لاگ
DOWNLOAD_DIR=downloads
LOG_LEVEL=INFO
